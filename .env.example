# Copy to .env.local and set the keys for the destinations you want to enable.
SIGNOZ_INGESTION_KEY=
DD_API_KEY=

# These values match the defaults in instrumentation.node.js.
OTEL_SERVICE_NAME=Calypso
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://ingest.us2.signoz.cloud:443/v1/traces
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://ingest.us2.signoz.cloud:443/v1/logs
# Datadog US1 (app.datadoghq.com), separate from the SigNoz endpoints.
DD_LOGS_OTLP_ENDPOINT=https://otlp.datadoghq.com/v1/logs
DD_TRACES_OTLP_ENDPOINT=https://otlp.datadoghq.com/v1/traces
OTEL_LOG_LEVEL=error
